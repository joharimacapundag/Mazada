<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:Mazada.ViewModel"
                    xmlns:views="clr-namespace:Mazada.View"
                    >

    <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
        <views:LoginView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
        <views:HomeView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:ProductCollectionViewModel}">
        <views:ProductCollectionView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type viewModels:ProductDetailView}">
        <views:ProductDetailView/>
    </DataTemplate>

</ResourceDictionary>
